{
  "compatibility_schema": "qwp777-api-compatibility-1",
  "snapshot_release": "2.7.0",
  "snapshot_api_version": "2.7",
  "experiment_result_schema": "qwp777-experiment-1",
  "public_exports": [
    "__version__",
    "API_VERSION",
    "run_circuit",
    "run_experiment",
    "compare_distributions",
    "validate_gates",
    "validate_result",
    "ExperimentError",
    "CircuitSchemaError",
    "ResultContractError",
    "summarize_counts",
