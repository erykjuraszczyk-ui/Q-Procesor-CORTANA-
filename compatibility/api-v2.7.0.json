  "required_callable_exports": [
    "run_circuit",
    "run_experiment",
    "compare_distributions",
    "validate_gates",
    "validate_result",
    "summarize_counts",
    "statevector_probabilities",
    "validate_probability_distribution",
    "compare_counts_to_reference"
  ],
  "notes": [
    "QWP-777 v2.7.0 freezes the v2.7 public export names and callable signatures.",
    "The experiment result schema remains qwp777-experiment-1; the release packager is an opt-in diagnostics CLI and does not expand qwp777_api.__all__.",
    "The release manifest hashes each file except itself. A detached ZIP SHA-256 sidecar protects archive integrity, but is not a publisher signature.",
    "Historical API snapshots remain immutable compatibility gates. This is a source-level contract, not a complete semantic proof."
  ],
  "callable_signatures": {
    "run_circuit": "(config)",
    "run_experiment": "(num_qubits, gates, shots=1000, seed=7, noise_probability=0.0)",
    "compare_distributions": "(observed, reference)",
    "validate_gates": "(gates, num_qubits)",
    "validate_result": "(result)",
    "summarize_counts": "(counts, shots=None)",
    "statevector_probabilities": "(num_qubits, gates)",
    "validate_probability_distribution": "(distribution, tolerance=1e-09)",
    "compare_counts_to_reference": "(num_qubits, unitary_gates, counts)"
  }
}
